# Ignore everything
*

# Only track EXEs directly inside installer_output
!installer_output/
!installer_output/*.exe
!installer_output/upload_installer.bat

# Ignore backup/notyet folders (old installers — not needed in repo)
installer_output/backup/
installer_output/notyet/

# Keep gitignore and gitattributes
!.gitignore
!.gitattributes
